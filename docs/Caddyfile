# VLGR Tunnel — Caddy configuration
# Place in /etc/caddy/Caddyfile or import into your main config.
#
# Requires:
#   1. caddy-dns/cloudflare plugin installed (see GETTING_STARTED.md)
#   2. CF_API_TOKEN environment variable set (Cloudflare API token with DNS:Edit)
#   3. DNS records: tunnel.domain.com and *.tunnel.domain.com → VPS IP (gray cloud)

# WebSocket endpoint — clients connect here
tunnel.domain.com {
    reverse_proxy 127.0.0.1:4443
}

# Public HTTP traffic — external users hit <subdomain>.tunnel.domain.com
*.tunnel.domain.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    reverse_proxy 127.0.0.1:8080
}
